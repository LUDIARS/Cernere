{
  "project": {
    "key": "glab",
    "name": "GLab",
    "description": "GLab operations hub"
  },

  "endpoint": {
    "url": "http://localhost:5187",
    "frontend_url": "https://glab.ai-run-do.com",
    "same_server": true,
    "bridge_path": "/glab"
  },

  "data_sharing": [],

  "signup_fields": {
    "version": 1,
    "fields": [
      { "project": "vantan_user", "column": "name", "label": "名前", "required": true, "input": "text", "max_length": 200 },
      { "project": "vantan_user", "column": "role_title", "label": "役職", "required": true, "input": "text", "max_length": 200 },
      { "project": "vantan_user", "column": "department_name", "label": "学科", "required": true, "input": "text", "max_length": 200 }
    ]
  },

  "user_data": {
    "columns": {
      "available_now": { "type": "boolean", "module": "presence", "nullable": true, "default_value": "false", "description": "おれひま" },
      "available_until": { "type": "timestamp", "module": "presence", "nullable": true, "description": "おれひま有効期限" },
      "current_location": { "type": "text", "module": "presence", "nullable": true, "description": "本人申告の現在地" }
    }
  }
}
