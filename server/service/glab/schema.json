{
  "project": {
    "key": "glab",
    "name": "GLab",
    "description": "GLab operations hub"
  },

  "endpoint": {
    "url": "http://localhost:5187",
    "frontend_url": "https://glab.ai-run-do.com",
    "same_server": true,
    "bridge_path": "/glab"
  },

  "data_sharing": [
    { "project_key": "aedilis", "modules": ["profile"], "access": "read" }
  ],

  "signup_fields": {
    "version": 3,
    "fields": [
      { "column": "member_type", "label": "在校生／OB", "required": true, "input": "tabs", "options": [{ "value": "student", "label": "在校生" }, { "value": "alumni", "label": "OB" }] },
      { "column": "name", "label": "名前", "required": true, "input": "text", "max_length": 200 },
      { "column": "nickname", "label": "ニックネーム", "required": false, "input": "text", "max_length": 200 },
      { "column": "role_title", "label": "役職", "required": true, "input": "text", "max_length": 200 },
      { "column": "department_name", "label": "学科", "required": true, "input": "text", "max_length": 200, "visible_when": { "column": "member_type", "value": "student" } },
      { "column": "grade", "label": "学年", "required": true, "input": "number", "minimum": 1, "visible_when": { "column": "member_type", "value": "student" } },
      { "column": "company", "label": "会社", "required": false, "input": "text", "max_length": 200, "visible_when": { "column": "member_type", "value": "alumni" } }
    ]
  },

  "user_data": {
    "columns": {
      "name": { "type": "text", "module": "profile", "nullable": false, "description": "氏名" },
      "role_title": { "type": "text", "module": "profile", "nullable": false, "description": "役職" },
      "member_type": { "type": "text", "module": "profile", "nullable": true, "description": "在校生 student / OB alumni" },
      "nickname": { "type": "text", "module": "profile", "nullable": true, "description": "任意のニックネーム" },
      "company": { "type": "text", "module": "profile", "nullable": true, "description": "OBの会社（任意）" },
      "department_name": { "type": "text", "module": "profile", "nullable": true, "description": "所属学科（在校生は必須）" },
      "grade": { "type": "integer", "module": "profile", "nullable": true, "description": "学年" },
      "desired_job": { "type": "text", "module": "profile", "nullable": true, "description": "希望職種" },
      "available_now": { "type": "boolean", "module": "presence", "nullable": true, "default_value": "false", "description": "おれひま" },
      "available_until": { "type": "timestamp", "module": "presence", "nullable": true, "description": "おれひま有効期限" },
      "current_location": { "type": "text", "module": "presence", "nullable": true, "description": "本人申告の現在地" }
    }
  }
}
